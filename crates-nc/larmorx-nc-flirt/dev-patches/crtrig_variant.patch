 /// The version of the FSL release these translations follow.
 pub const FSL_VERSION: &str = "6.0.7.23";
+
+/// Development hook (never committed in the source; `dev-patches/crtrig_variant.patch`):
+/// `LXNC_CRTRIG` set makes `sinf`, `cosf`, `sincosf` and `atan2f` the correctly rounded ones.
+pub fn dev_crtrig() -> bool {
+    dev_crtrig_is("sin")
+}
+
+/// `LXNC_CRTRIG` = `all`, `sin` (`sinf`, `cosf`, `sincosf`) or `atan` (`atan2f`).
+pub fn dev_crtrig_is(which: &str) -> bool {
+    static F: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    let v = F.get_or_init(|| std::env::var("LXNC_CRTRIG").unwrap_or_default());
+    v == "all" || v == which
+}
